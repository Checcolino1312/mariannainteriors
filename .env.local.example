# Copia questo file in `.env.local` e compila i valori (vedi docs/sanity.md).
# `.env.local` è ignorato da git: non finisce nel repository.
# Senza le variabili Sanity il sito funziona lo stesso, con i contenuti di src/content.

# --- Progetto Sanity (da https://www.sanity.io/manage) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Versione delle API Sanity: lasciare così, bloccarla evita cambi di risposta senza preavviso.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27

# --- Token di scrittura (solo per l'import iniziale, NON serve su Vercel) ---
# sanity.io/manage -> progetto -> API -> Tokens -> Add API token, permessi "Editor".
SANITY_API_WRITE_TOKEN=

# --- Webhook di aggiornamento ---
# Una stringa casuale lunga: va incollata identica nel webhook su sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# --- Altri servizi (già usati dal sito) ---
# Feed Instagram di Behold.so
BEHOLD_FEED_ID=
# Valori iniziali per l'import; dopo si modificano nello Studio (Impostazioni / Servizi)
NEXT_PUBLIC_CAL_LINK=marianna.interiors/consulenza-60min
NEXT_PUBLIC_MAPPA_PAYMENT_LINK=
